#!/bin/bash -e

# Prepare DB schema when booting the web server or the Solid Queue worker.
if { [ "${@: -2:1}" == "./bin/rails" ] || [ "${@: -2:1}" == "bin/rails" ]; } && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
elif [ "$1" == "./bin/jobs" ] || [ "$1" == "bin/jobs" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
