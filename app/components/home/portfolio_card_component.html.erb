<article
  class="portfolio-card<%= " is-active" if active? %>"
  data-portfolio-target="slide"
  aria-hidden="<%= active? ? "false" : "true" %>"
  <%= "hidden" unless active? %>>

  <div class="portfolio-left">
    <div class="portfolio-box portfolio-box--overview">
      <div class="portfolio-tags">
        <% project[:tags].each do |tag| %>
          <span class="tag"><%= tag %></span>
        <% end %>
      </div>
      <h3><%= project[:name] %></h3>
      <p><%= project[:description] %></p>
    </div>

    <div class="portfolio-bottom">
      <div class="portfolio-box portfolio-box--techs">
        <h4><%= ht("portfolio.technologies") %></h4>
        <ul class="tech-icons">
          <% project[:techs].each do |tech| %>
            <li title="<%= tech %>">
              <%= render Ui::TechIconComponent.new(name: tech) %>
              <span class="visually-hidden"><%= tech %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="portfolio-box portfolio-box--platforms">
        <h4><%= ht("portfolio.platforms") %></h4>
        <ul class="platform-buttons">
          <% project[:platforms].each do |platform| %>
            <li>
              <span class="platform-btn">
                <% case platform_icon(platform) %>
                <% when :apple %>
                  <%= render Ui::TechIconComponent.new(name: "iOS", class_name: "platform-tech-icon") %>
                <% when :android %>
                  <%= render Ui::TechIconComponent.new(name: "Android", class_name: "platform-tech-icon") %>
                <% else %>
                  <svg class="platform-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
                    <path d="M3 12h18M12 3c2.5 2.8 3.8 5.8 3.8 9S14.5 18.2 12 21c-2.5-2.8-3.8-5.8-3.8-9S9.5 5.8 12 3z" stroke="currentColor" stroke-width="1.6"/>
                  </svg>
                <% end %>
                <%= platform %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <div class="portfolio-visual tone-<%= project[:tone] %>" aria-hidden="true">
    <div class="portfolio-visual-overlay"></div>
    <div class="phone-stack">
      <div class="phone phone--back">
        <div class="phone-ui">
          <span class="phone-ui-bar"></span>
          <span class="phone-ui-card"></span>
          <span class="phone-ui-card phone-ui-card--sm"></span>
        </div>
      </div>
      <div class="phone phone--front">
        <div class="phone-ui phone-ui--alt">
          <span class="phone-ui-bar"></span>
          <span class="phone-ui-grid">
            <i></i><i></i><i></i><i></i>
          </span>
        </div>
      </div>
    </div>
  </div>
</article>
