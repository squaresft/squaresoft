<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#0d0d0d;padding:32px 16px;">
  <tr>
    <td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background:#161616;border:1px solid rgba(255,255,255,0.08);">
        <tr>
          <td style="height:3px;background:linear-gradient(90deg,#7B3FF3,#3F83F8);font-size:0;line-height:0;">&nbsp;</td>
        </tr>
        <tr>
          <td style="padding:36px 32px 28px;">
            <p style="margin:0 0 28px;font-size:18px;font-weight:700;letter-spacing:-0.03em;color:#ffffff;">
              square
            </p>

            <p style="margin:0 0 8px;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#93c5fd;">
              <%= t("lead_mailer.received.eyebrow") %>
            </p>

            <h1 style="margin:0 0 16px;font-size:26px;line-height:1.2;font-weight:700;letter-spacing:-0.03em;color:#ffffff;">
              <%= t("lead_mailer.received.greeting", name: @lead.full_name.split.first) %>
            </h1>

            <p style="margin:0 0 14px;font-size:16px;line-height:1.6;color:#c4c4c4;">
              <%= t("lead_mailer.received.intro") %>
            </p>

            <p style="margin:0 0 14px;font-size:16px;line-height:1.6;color:#c4c4c4;">
              <%= t("lead_mailer.received.body") %>
            </p>

            <p style="margin:0 0 28px;font-size:16px;line-height:1.6;color:#c4c4c4;">
              <%= t("lead_mailer.received.closing") %>
            </p>

            <p style="margin:0;font-size:15px;line-height:1.5;color:#f5f5f5;">
              <%= t("lead_mailer.received.signoff") %><br>
              <strong style="color:#ffffff;"><%= t("lead_mailer.received.team") %></strong>
            </p>
          </td>
        </tr>
        <tr>
          <td style="padding:20px 32px 28px;border-top:1px solid rgba(255,255,255,0.08);">
            <p style="margin:0 0 6px;font-size:12px;letter-spacing:0.04em;color:#8b8b8b;">
              SQUARE — Digital Product Studio
            </p>
            <p style="margin:0;font-size:11px;line-height:1.5;color:#6b6b6b;">
              <%= t("lead_mailer.received.copyright", year: @year) %>
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
